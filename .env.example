# Supabase Edge Function secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Frontend public Supabase client settings
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the project's publishable key. VITE_SUPABASE_ANON_KEY remains a legacy fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Set true only for the local test mode; production must use Supabase Auth.
VITE_LOCAL_DEVELOPMENT_MODE=false
# Optional stable base URL for auth emails (password reset). Reset emails are
# opened later, often on another device, so they must link to the DEPLOYED app,
# never to the local instance that sent the request (127.0.0.1 in a preview).
# Production sets this explicitly so reset links keep pointing at the deployed
# app even if the Supabase Site URL drifts; when unset, the reset email falls
# back to the Supabase Site URL configured in the dashboard (Authentication >
# URL Configuration). Production value:
#   https://mealledger.g1014308.workers.dev
# The URL (plus /account) must be whitelisted under Supabase
# Authentication > URL Configuration > Redirect URLs.
VITE_AUTH_REDIRECT_URL=

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=meal-ledger-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Optional AI integration
# Prefer the edge-function proxy for production: the key stays server-side
# and browser CORS is handled by Supabase. When AI_EDGE_FUNCTION_URL is set
# the client posts to it instead of calling the provider directly.
AI_EDGE_FUNCTION_URL=
AI_PROVIDER=openai-or-gemini
AI_API_KEY=replace-with-ai-key
# Optional provider base URL override (defaults: OpenAI / Gemini official endpoints)
# Example: AI_BASE_URL=https://api.tokenrouter.com/v1
AI_BASE_URL=
# Optional model override (defaults: gpt-4o-mini for openai, gemini-2.0-flash for gemini)
AI_MODEL=
# Optional vision-capable model for receipt/invoice photo parsing.
# Falls back to AI_MODEL when unset.
AI_VISION_MODEL=
# The ai-parse edge function requires a valid user session by default.
# Local development can disable that gate with AI_REQUIRE_AUTH=false so
# signed-out users can still use the AI panel.
AI_REQUIRE_AUTH=

# ---------------------------------------------------------------------------
# [TEMPLATE] Frontend production build -- set these in the hosting platform
# (Cloudflare Workers dashboard or wrangler), never in the repo: .env.* is
# gitignored and values here would leak into the built bundle or be committed
# by mistake.
# Production app URL (Cloudflare Workers):
#   https://mealledger.g1014308.workers.dev
# ---------------------------------------------------------------------------
