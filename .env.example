# Supabase Edge Function secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Frontend public Supabase client settings
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the project's publishable key. VITE_SUPABASE_ANON_KEY remains a legacy fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Set true only for the local test mode; production must use Supabase Auth.
VITE_LOCAL_DEVELOPMENT_MODE=false

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=meal-ledger-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Optional AI integration
# Prefer the edge-function proxy for production: the key stays server-side
# and browser CORS is handled by Supabase. When AI_EDGE_FUNCTION_URL is set
# the client posts to it instead of calling the provider directly.
AI_EDGE_FUNCTION_URL=
AI_PROVIDER=openai-or-gemini
AI_API_KEY=replace-with-ai-key
# Optional provider base URL override (defaults: OpenAI / Gemini official endpoints)
# Example: AI_BASE_URL=https://api.tokenrouter.com/v1
AI_BASE_URL=
# Optional model override (defaults: gpt-4o-mini for openai, gemini-2.0-flash for gemini)
AI_MODEL=
# Optional vision-capable model for receipt/invoice photo parsing.
# Falls back to AI_MODEL when unset.
AI_VISION_MODEL=

# ---------------------------------------------------------------------------
# [TEMPLATE] Frontend production build -- set these in the hosting platform
# (Cloudflare Workers dashboard or wrangler), never in the repo: .env.* is
# gitignored and values here would leak into the built bundle or be committed
# by mistake.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://rolsgcftiqvobdfzsktu.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# VITE_LOCAL_DEVELOPMENT_MODE=false
# AI_EDGE_FUNCTION_URL=https://rolsgcftiqvobdfzsktu.supabase.co/functions/v1/ai-parse
